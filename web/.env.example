# Copy this file to web/.env.local and fill in real values.
# .env.local is gitignored.
#
# Find these in the Supabase dashboard → Project Settings → API:
#   Project URL              → VITE_SUPABASE_URL
#   Publishable / anon key   → VITE_SUPABASE_ANON_KEY
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
